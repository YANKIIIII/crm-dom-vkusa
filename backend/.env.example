# Copy to backend/.env and fill in real values.
# Never commit backend/.env.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
# Dev: localhost. Prod: ALLOWED_HOSTS=crm.example.com,backend
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Dev: http://localhost:5173. Prod: CORS_ALLOWED_ORIGINS=https://crm.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Postgres (used by Django and the postgres container via env_file)
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Force SQLite for local unit tests / makemigrations without Docker.
# Leave False (or unset) in Docker and production.
USE_SQLITE=False

# Behind a TLS-terminating reverse proxy set SECURE_SSL_REDIRECT=False
# and terminate TLS at the edge. docker-compose.prod.yml does this.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
