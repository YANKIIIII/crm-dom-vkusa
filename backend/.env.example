# Copy to backend/.env and fill in real values.
# Never commit backend/.env.
#
# This file is for local development. docker-compose.prod.yml overrides
# DEBUG and SECURE_SSL_REDIRECT regardless of what is in .env.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
# Dev: localhost. Prod: ALLOWED_HOSTS=domcrm.space,backend
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Dev: http://localhost:5173. Prod: CORS_ALLOWED_ORIGINS=https://domcrm.space
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Postgres (used by Django and the postgres container via env_file)
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Force SQLite for local unit tests / makemigrations without Docker.
# Leave False (or unset) in Docker and production.
USE_SQLITE=False

# Local runserver has no TLS. Behind Caddy in production, docker-compose.prod.yml
# sets SECURE_SSL_REDIRECT=False (TLS terminates at the edge).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# How many reverse proxies sit in front of gunicorn.
# Host pytest / direct runserver: 0 (ignore X-Forwarded-For).
# docker-compose.prod.yml overrides this to 2 (Caddy + nginx).
NUM_PROXIES=0
